{
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "Backend",
      "entrypoint": "index.js",
      "routePrefix": "/_/backend"
    }
  },
  "rewrites": [
    { "source": "/((?!_/backend).*)", "destination": "/index.html" }
  ]
}
